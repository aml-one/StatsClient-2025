<Window x:Class="StatsClient.MVVM.View.AvailablePanNumberNotifications"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StatsClient.MVVM.View"
        xmlns:core="clr-namespace:StatsClient.MVVM.Core"
        xmlns:viewmodel="clr-namespace:StatsClient.MVVM.ViewModel"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Topmost="True"
        WindowStyle="None"
        WindowState="Maximized"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Title="AvailablePanNumberNotifications"
        Opacity="{Binding WindowOpacity}"
        Height="80"
        Width="800">

    <Window.DataContext>
        <viewmodel:AvailablePanNumberNotificationsViewModel />
    </Window.DataContext>

    <Window.Background>
        <SolidColorBrush Color="Transparent"
                         Opacity="0.00"
                         d:Opacity="0.25" />
    </Window.Background>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/LvItemModern.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="15,15,15,45"
          Opacity="{Binding ListOpacity}">

        <StackPanel HorizontalAlignment="{Binding BadgePositionHorizontal}"
                    VerticalAlignment="{Binding BadgePositionVertical}">
            <core:OutlinedTextBlock Stroke="Black"
                                    StrokePosition="Outside"
                                    FontSize="{Binding TitleFontSize}"
                                    FontWeight="SemiBold"
                                    Fill="#42ff48"
                                    StrokeThickness="1"
                                    Text="Available Pan Numbers"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Margin="15,0,15,-30"
                                    Grid.Row="0" />
            <ListView MinWidth="400"
                      MinHeight="70"
                      MaxHeight="800"
                      Background="Transparent"
                      BorderThickness="0"
                      VerticalAlignment="Bottom"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      ItemsSource="{Binding AvailablePanNumberCountList}"
                      ItemContainerStyle="{StaticResource LvAvailablePanNumberCountList}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="IsMouseOver">
                        <i:InvokeCommandAction Command="{Binding MouseOverCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ListView>

        </StackPanel>
    </Grid>
</Window>
